# Create the bot with @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=

# Start once with this empty, send /whoami, then add the returned numeric ID
# and restart. Multiple IDs are comma-separated.
ALLOWED_TELEGRAM_USER_IDS=

# Create a project API key at platform.openai.com. Never send it in Telegram.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_IMAGE_DETAIL=auto

HEALTH_DIARY_TIMEZONE=Europe/Moscow
TELEGRAM_POLL_TIMEOUT=30
MAX_MEDIA_BYTES=20971520

# When true, confirming a completed day runs one scoped commit and push.
# The host must already have working Git credentials and a clean staging area.
AUTO_GIT_SYNC=false
GIT_REMOTE=origin
GIT_BRANCH=main
