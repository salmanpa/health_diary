{
  "name": "health-diary-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dashboard:dev": "vite --config dashboard-src/vite.config.ts",
    "dashboard:build": "tsc -p dashboard-src/tsconfig.json --noEmit && sh scripts/build_dashboard_variants.sh",
    "dashboard:preview": "vite preview --config dashboard-src/vite.config.ts",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && vitest run --config dashboard-src/vitest.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "echarts": "^6.1.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
