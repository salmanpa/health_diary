[Unit]
Description=Private health_diary Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=healthdiary
WorkingDirectory=/opt/health_diary
EnvironmentFile=/opt/health_diary/.env
ExecStartPre=/opt/health_diary/scripts/build_dashboard.sh
ExecStart=/usr/bin/python3 -m healthbot.app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
